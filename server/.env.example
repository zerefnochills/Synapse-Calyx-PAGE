# ============================================
# SYNAPSE CALYX — SERVER ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017/synapse-calyx
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/synapse-calyx
MONGODB_URI=mongodb://localhost:27017/synapse-calyx

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Admin API Key ---
# Used to protect admin endpoints (GET/PATCH/DELETE orders)
# Generate a strong random string for production
ADMIN_API_KEY=your-secret-admin-key-change-this

# --- Email (SMTP) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use an App Password, not your regular password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Notification Recipients ---
ADMIN_EMAIL=admin@synapsecalyx.com
